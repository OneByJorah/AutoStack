# Headroom / Aphrodite overlay environment
# Copied to .env.headroom by scripts/init-headroom.sh.
# Loaded via env_file into the headroom-proxy container.

# OpenAI-compatible upstream target for the proxy:
HEADROOM_OPENAI_TARGET_API_URL=

# NOTE: NEO4J_AUTH is NOT read from this file — docker-compose.headroom.yml
# interpolates it from the ROOT .env. Add it there, e.g.:
#   NEO4J_AUTH=neo4j/change_me_headroom_password
