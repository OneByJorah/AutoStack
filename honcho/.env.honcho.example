# Honcho overlay environment — copied to .env.honcho by scripts/init-honcho.sh
# and loaded via env_file into the honcho-api container. Fill in real values.

# Primary provider (OpenAI-compatible; OpenRouter works well)
LLM_VLLM_API_KEY=
LLM_VLLM_BASE_URL=https://openrouter.ai/api/v1

# Embeddings (can reuse the primary key/URL)
LLM_EMBEDDING_API_KEY=
LLM_EMBEDDING_BASE_URL=
LLM_EMBEDDING_MODEL=openai/text-embedding-3-small

# Database password for the honcho-db container (also referenced by
# DB_CONNECTION_URI in docker-compose.honcho.yml)
HONCHO_DB_PASSWORD=change_me_db_password

# Optional auth token for the Honcho API
HONCHO_TOKEN=change_me_honcho_token
