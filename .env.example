# AutoStack — Environment Configuration
# Copy this file to .env and fill in your values.

# ── Server Identity ──────────────────────────────────────
# Host IP used by Cloudflare Tunnel ingress and docs. Defaults to 127.0.0.1.
HOST_IP=<set-value>

# ── Hermes Stack ──────────────────────────────────────────
HERMES_API_KEY=<set-value>
HERMES_WEBHOOK_URL=http://localhost:8080/webhook

# ── CostForge ──────────────────────────────────────────────
COSTFORGE_API_URL=http://costforge:8000
COSTFORGE_API_KEY=<set-value>

# ── NOC Dashboard (optional overlay) ───────────────────────
NOC_DASHBOARD_PORT=9500
NOC_POLL_INTERVAL=10

# ── Honcho (Memory Layer) ──────────────────────────────────
HONCHO_IMAGE=ghcr.io/onebyjorah/honcho:latest
HONCHO_DB_PASSWORD=<set-value>
HONCHO_TOKEN=<set-value>

# ── Ollama ─────────────────────────────────────────────────
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

# ── Paths ──────────────────────────────────────────────────
# Host path for the Obsidian vault and Cloudflare credentials.
OBSIDIAN_VAULT_PATH=/opt/autostack/ObsidianVault
CF_CREDENTIALS_DIR=/opt/autostack/.cloudflared

# ── Service Binds ──────────────────────────────────────────
# Loopback by default (see SECURITY.md). Set to 0.0.0.0 to expose
# on the host LAN/Tailnet (the tailscale and all profiles do this).
QDRANT_BIND=<set-value>
SELENIUM_VNC_BIND=<set-value>

# ── Logging ────────────────────────────────────────────────
LOG_LEVEL=INFO
